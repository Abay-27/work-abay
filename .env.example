# Email Configuration (Gmail)
# IMPORTANT: For Gmail, you MUST use an "App Password", not your regular password.
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to Security > App Passwords.
# 3. Generate a password for "Mail" and "Other (Custom Name)".
# 4. Use that 16-character code here.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
ADMIN_EMAIL=abaygebeyaw1996@gmail.com

# Gemini API Key
GEMINI_API_KEY=

# Twilio Configuration (Optional for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps API Key for Places Autocomplete
VITE_GOOGLE_MAPS_API_KEY=
